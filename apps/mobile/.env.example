# Demo planning needs no credentials. The Ticketmaster venue preview uses the server separately.
EXPO_PUBLIC_DATA_MODE=demo
# Used for live planning and the Ticketmaster venue map (also in demo planning mode).
# Absolute server origin, without /api. Never put API keys here.
# Device on Wi-Fi: http://YOUR_COMPUTER_LAN_IP:3001
# Android emulator: http://10.0.2.2:3001; iOS simulator: http://localhost:3001
EXPO_PUBLIC_API_URL=
# Optional build-time Maps SDK keys (embedded in native binaries; restrict by app).
# These are separate from the server-only Places/Routes key. Rebuild to apply.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
