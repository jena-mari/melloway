{
  "name": "melloway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --experimental-strip-types --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js && npm run test:mobile && npm run test:events && npm run test:discovery",
    "test:discovery": "node --experimental-strip-types --test tests/openai-social-discovery.test.ts tests/discovery-review-queue.test.ts tests/discovery-export.test.ts",
    "prediscovery:review": "npm run build:domain",
    "discovery:review": "node --experimental-strip-types scripts/discovery-review.ts",
    "typecheck:discovery": "tsc -p server/tsconfig.discovery.json",
    "test:events": "node --experimental-strip-types --test tests/ticketmaster.test.ts tests/event-map.test.ts",
    "events:sydney": "node --experimental-strip-types --env-file-if-exists=.env scripts/fetch-sydney-events.ts",
    "build:domain": "npm run build --workspace @melloway/domain",
    "postinstall": "npm run build:domain",
    "predev": "npm run build:domain",
    "prebuild": "npm run build:domain",
    "preserver": "npm run build:domain",
    "pretest": "npm run build:domain",
    "mobile": "npm run start --workspace @melloway/mobile --",
    "mobile:web": "npm run web --workspace @melloway/mobile --",
    "typecheck": "npm run typecheck --workspace @melloway/domain && npm run typecheck --workspace @melloway/mobile && npm run typecheck:discovery",
    "test:mobile": "node --experimental-strip-types --test tests/mobile/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install chromium"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.0.0",
    "framer-motion": "^12.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "@supabase/supabase-js": "^2.49.0",
    "@capacitor/core": "^7.0.0",
    "@melloway/domain": "1.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@capacitor/cli": "^7.0.0",
    "typescript": "~6.0.3",
    "@playwright/test": "^1.64.0"
  },
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
