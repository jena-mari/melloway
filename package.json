{
  "name": "melloway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --experimental-strip-types --env-file-if-exists=.env server/index.js",
    "test": "node --experimental-strip-types --test tests/*.test.js && npm run test:events && npm run test:discovery",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install chromium",
    "build:domain": "npm run build --workspace @melloway/domain",
    "postinstall": "npm run build:domain",
    "predev": "npm run build:domain",
    "prebuild": "npm run build:domain",
    "preserver": "npm run build:domain",
    "pretest": "npm run build:domain",
    "typecheck": "npm run typecheck --workspace @melloway/domain && npm run typecheck:backend",
    "typecheck:backend": "tsc -p server/tsconfig.discovery.json",
    "typecheck:discovery": "npm run typecheck:backend",
    "test:events": "node --experimental-strip-types --test tests/ticketmaster.test.ts tests/events.test.ts",
    "test:discovery": "node --experimental-strip-types --test tests/openai-social-discovery.test.ts tests/discovery-review-queue.test.ts tests/discovery-export.test.ts",
    "events:sydney": "node --experimental-strip-types --env-file-if-exists=.env scripts/fetch-sydney-events.ts",
    "prediscovery:review": "npm run build:domain",
    "discovery:review": "node --experimental-strip-types scripts/discovery-review.ts"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@supabase/supabase-js": "^2.49.0",
    "framer-motion": "^12.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "@melloway/domain": "1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "typescript": "~6.0.3",
    "@types/node": "26.6.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
