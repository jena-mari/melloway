{
  "name": "melloway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js && npm run test:mobile",
    "build:domain": "npm run build --workspace @melloway/domain",
    "postinstall": "npm run build:domain",
    "predev": "npm run build:domain",
    "prebuild": "npm run build:domain",
    "preserver": "npm run build:domain",
    "pretest": "npm run build:domain",
    "mobile": "npm run start --workspace @melloway/mobile --",
    "mobile:web": "npm run web --workspace @melloway/mobile --",
    "typecheck": "npm run typecheck --workspace @melloway/domain && npm run typecheck --workspace @melloway/mobile",
    "test:mobile": "node --experimental-strip-types --test tests/mobile/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "@supabase/supabase-js": "^2.49.0",
    "@capacitor/core": "^7.0.0",
    "@melloway/domain": "1.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@capacitor/cli": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  }
}
