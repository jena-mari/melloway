# Server only. Never use a VITE_ prefix for this key.
GOOGLE_MAPS_API_KEY=
# Server-only Ticketmaster Discovery API key for the standalone events runner.
TICKETMASTER_API_KEY=
# No-billing Maps Demo Key for the Ticketmaster JavaScript map prototype.
# Visible in the map page. Get through the Demo Key flow; do not attach billing.
# Never use the server Places/Routes or Ticketmaster key here.
GOOGLE_MAPS_DEMO_KEY=
PORT=3001
# Opt in to LAN access for native-device live integration; default is loopback.
HOST=127.0.0.1
# Optional PUBLIC Maps Embed API key for live Google Places routes in the app.
# Use a separate key restricted to Maps Embed API and your app's HTTP referrers.
# Never put the server key above here. Without it, live plans link to Google Maps.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Demo map tiles default to OpenStreetMap. Optional replacement provider settings.
# Set all three together, including your provider's required attribution.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILE_ATTRIBUTION_URL=
# Optional browser-safe Supabase configuration with RLS enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# For a packaged Capacitor app, set the public HTTPS API origin.
# Leave empty for the local browser proxy. This is not a secret.
VITE_API_BASE_URL=
# Remote backend origins allowed to call the API, comma separated.
# Example: capacitor://localhost,http://localhost
APP_ORIGINS=
