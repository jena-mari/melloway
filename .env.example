# Server keys — replace these placeholders
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Place-page social discovery uses billed web search. Set false to disable it.
OPENAI_SOCIAL_SEARCH=true
PORT=

# Optional separate public Maps Embed key
VITE_GOOGLE_MAPS_EMBED_KEY=

# Leave these blank for now
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILE_ATTRIBUTION_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
APP_ORIGINS=

# Private Ticketmaster Discovery API credential, never sent to the browser.
TICKETMASTER_API_KEY=
# Dedicated browser map key; restricted to Maps JavaScript API and website referrers.
# Preferred over the optional Demo Key. Do not reuse private Places/Routes credentials.
GOOGLE_MAPS_JS_KEY=
GOOGLE_MAPS_DEMO_KEY=
# Isolated social discovery model. Only the explicit CLI live command uses it.
# OPENAI_API_KEY above remains server-side; OPENAI_MODEL above keeps its existing purpose.
OPENAI_DISCOVERY_MODEL=

# Optional private local TikTokApi session cookie; never paste or commit the real value.
TIKTOK_MS_TOKEN=
# Optional path to another local TikTokApi virtual environment Python.
TIKTOK_PYTHON=
