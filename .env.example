# Server keys — replace these placeholders
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: additional cached editorial/community/social web research (billed API usage).
# Set false to use only the checked source evidence and existing ranking.
OPENAI_RECOMMENDATION_RESEARCH=true
# Venue posts and What's On Instagram discovery use billed web search. Set false to disable both.
OPENAI_SOCIAL_SEARCH=true
PORT=

# Legacy Embed setting (not used by the current map screens)
VITE_GOOGLE_MAPS_EMBED_KEY=

# Legacy tile-provider settings (current screens use Google Maps)
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
VITE_MAP_TILE_ATTRIBUTION_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
APP_ORIGINS=

# Private Ticketmaster Discovery API credential, never sent to the browser.
TICKETMASTER_API_KEY=
# Dedicated browser map key; restricted to Maps JavaScript API and website referrers.
# Preferred over the optional Demo Key. Do not reuse private Places/Routes credentials.
GOOGLE_MAPS_JS_KEY=
GOOGLE_MAPS_DEMO_KEY=
# Optional production Google Maps map ID. The development default is DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=
# Isolated social discovery model. Only the explicit CLI live command uses it.
# OPENAI_API_KEY above remains server-side; OPENAI_MODEL above keeps its existing purpose.
OPENAI_DISCOVERY_MODEL=

# Optional private local TikTokApi session cookie; never paste or commit the real value.
TIKTOK_MS_TOKEN=
# Optional path to another local TikTokApi virtual environment Python.
TIKTOK_PYTHON=

# Explicit LAN access for native-device testing; loopback by default.
HOST=127.0.0.1

# Optional organiser code for shared Hack48 uploads. Keep private; never VITE_.
# When empty, the server creates .local/shared-events/hack48.edit-code automatically.
HACK48_EDIT_CODE=
# Optional persistent storage directory; default: .local/shared-events
SHARED_EVENTS_DIRECTORY=
